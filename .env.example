# Copy to .env and add your free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# Or use any OpenAI-compatible provider instead of Gemini (takes priority when both are set)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Power-ups per visitor per day when a key is set
DAILY_BUILDS=10
