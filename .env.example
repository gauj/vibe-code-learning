# Copy to .env and add your free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# Or use an OpenAI-compatible provider instead of Gemini (takes priority when set)
LLM_API_KEY=
LLM_MODEL=
# Optional: defaults to https://api.cheaperinference.com/v1
LLM_BASE_URL=
# Power-ups per visitor per day when a key is set
DAILY_BUILDS=10
# Shown on the privacy page
AI_PROVIDER_NAME=
PRIVACY_CONTACT=
